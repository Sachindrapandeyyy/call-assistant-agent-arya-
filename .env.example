# ==============================================================================
# Aura AI Call Assistant - Configuration Template (.env.example)
# Copy this file to .env and configure your local settings and credentials.
# ==============================================================================

# --- Server Settings ---
HOST=127.0.0.1
PORT=8000

# --- Telephony & Timing ---
ANSWER_DELAY_SECONDS=4.0
MAX_CALL_DURATION_SECONDS=300.0
MAX_CLARIFICATION_ATTEMPTS=2
MAX_SILENCE_ATTEMPTS=2

# --- Audio Engine & Hardware Thresholds ---
AUDIO_SAMPLE_RATE=16000
PLAYBACK_SAMPLE_RATE=48000
VAD_THRESHOLD=0.035
SILENCE_TIMEOUT=0.85
MIN_SPEECH_DURATION=0.45
BARGE_IN_THRESHOLD=0.015
UPLINK_MODE=vb_cable

# --- Storage & Data Retention Policy ---
RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=60

# --- Local AI Models ---
# faster-whisper STT on RTX GPU
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8

# Ollama Local LLM
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.2:latest

# Cloud Hybrid LLM (Optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-Speech Engine
TTS_ENGINE=local
EDGE_VOICE=hi-IN-SwaraNeural

# --- Assistant Persona ---
USER_NAME=Sachindra Shekhar Pandey
USER_TITLE=Sachindra sir
ASSISTANT_NAME=Arya

# --- Notifications ---
NOTIFICATION_ENABLED=true
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
WHATSAPP_ENABLED=false
