<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_galaxy_gradient"
    android:paddingBottom="16dp">

    <!-- Top Header: Aura Galaxy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aura AI"
                android:textColor="#C77DFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keypad"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- T9 Live Contact Suggestions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvT9Suggestions"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone" />

    <!-- Dialed Number & Backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvDialedNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:hint=""
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="start" />

        <ImageView
            android:id="@+id/btnBackspace"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_delete"
            android:tint="#B388FF"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 4x3 Galaxy Keypad Grid -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:stretchColumns="*"
        android:paddingHorizontal="28dp">

        <!-- Row 1: 1, 2, 3 -->
        <TableRow android:layout_marginBottom="10dp" android:gravity="center">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey1"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="1\n "
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey2"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="2\nABC"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey3"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="3\nDEF"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>
        </TableRow>

        <!-- Row 2: 4, 5, 6 -->
        <TableRow android:layout_marginBottom="10dp" android:gravity="center">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey4"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="4\nGHI"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey5"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="5\nJKL"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey6"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="6\nMNO"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>
        </TableRow>

        <!-- Row 3: 7, 8, 9 -->
        <TableRow android:layout_marginBottom="10dp" android:gravity="center">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey7"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="7\nPQRS"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey8"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="8\nTUV"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey9"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="9\nWXYZ"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>
        </TableRow>

        <!-- Row 4: *, 0, # -->
        <TableRow android:layout_marginBottom="12dp" android:gravity="center">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKeyStar"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="*\n "
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKey0"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="0\n+"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button
                    android:id="@+id/btnKeyHash"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_galaxy_keypad_button"
                    android:text="#\n "
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </FrameLayout>
        </TableRow>

    </TableLayout>

    <!-- Row 5: Glowing Neon Starburst Call Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnCallAction"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_galaxy_call_button"
            android:src="@android:drawable/ic_menu_call"
            android:tint="#0A0618"
            android:elevation="8dp" />
    </FrameLayout>

</LinearLayout>
