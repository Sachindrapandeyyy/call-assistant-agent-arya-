<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_galaxy_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:elevation="3dp">

    <!-- Cosmic Gradient Initial Avatar -->
    <TextView
        android:id="@+id/tvContactInitial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_galaxy_avatar_supernova"
        android:gravity="center"
        android:text="H"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginEnd="14dp" />

    <!-- Name & Number -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harsh Sharma"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContactPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile • +91 98765 43210"
            android:textColor="#C77DFF"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Glowing Starburst Call Button -->
    <ImageView
        android:id="@+id/btnCallContact"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_call"
        android:tint="#00F59B"
        android:background="@drawable/bg_galaxy_keypad_button" />

</LinearLayout>
