# ==============================================================================
# Aura AI Personal Call Assistant - Production .gitignore
# ==============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.key
*.pem
*.token
*.credential

# --- Audio Recordings & Master WAVs ---
recordings/
data/recordings/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.pcm

# --- SQLite Databases & Real Caller Data ---
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
data/vip_contacts.json
data/callers_memory.json
*.db
*.db-wal
*.db-shm

# --- Logs, Temporary Diagnostics & Dumps ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.stackdump
*.dump
diagnostic/*.wav
scratch/

# --- Python Build & Bytecode ---
__pycache__/
*.py[cod]
*.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Android Build Artifacts & Gradle ---
.gradle/
android/**/.gradle/
android/**/build/
android/**/captures/
android/**/.cxx/
android/**/local.properties
android/**/GeneratedConfigurations/
android/**/app/build/
*.apk
*.aab
*.ap_
*.dex
*.class

# --- IDE & Editor Settings ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
# Virtual Audio Cable installation archives
vbcable*
vbcable/
